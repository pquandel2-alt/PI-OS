// Debian security updates (and Chromium from the Raspberry Pi archive) are installed by pios-os-upgrade.service,
// which holds the same lock as the PiOS Update Manager. Kernel, firmware and bootloader are never touched automatically.
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
    "origin=Raspberry Pi Foundation,codename=${distro_codename}";
};
Unattended-Upgrade::Package-Blacklist {
    "linux-image-.*";
    "linux-headers-.*";
    "raspi-firmware";
    "raspberrypi-.*";
    "rpi-eeprom.*";
    "firmware-.*";
    "libc6.*";
    "systemd.*";
    "network-manager.*";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
// the stock apt-daily timers must not run package operations behind the lock's back
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
