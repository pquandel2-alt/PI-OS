[Unit]
Description=PiOS NOVA backend (web desktop on port 80)
Documentation=file:///opt/pios/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=pios
Group=pios
WorkingDirectory=/opt/pios
Environment=PIOS_DATA=/var/lib/pios PIOS_WEB=/opt/pios/web PIOS_APPS=/opt/pios/apps PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m uvicorn pios.main:app --host 0.0.0.0 --port 80 --no-server-header --log-level warning
Restart=always
RestartSec=3
StateDirectory=pios
StateDirectoryMode=0700
UMask=0077

# Hardening: the backend only needs to bind port 80 and write /var/lib/pios.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
