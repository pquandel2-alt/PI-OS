[Unit]
Description=PiOS NOVA local desktop (cage + Chromium kiosk)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service pios.service
Wants=pios.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pios-kiosk
Group=pios-kiosk
EnvironmentFile=-/etc/pios/pios.conf
Environment=WLR_NO_HARDWARE_CURSORS=0
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/opt/pios/current/bin/pios-wait-ready
ExecStart=/usr/bin/cage -- /opt/pios/current/bin/pios-kiosk-browser
Restart=on-failure
RestartSec=5

# Sandboxing that is compatible with Chromium + Wayland (it must keep user namespaces for its own sandbox, GPU and input access;
# a seccomp/namespace filter here would break it). Verified only on real hardware - see docs/SHIELD.md.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/pios-kiosk
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
# Not enabled directly: pios-display.service starts and stops it with the monitor.
