[Unit]
Description=PiOS NOVA backend (web desktop on port 80)
Documentation=file:///opt/pios/current/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=pios
Group=pios
WorkingDirectory=/opt/pios/current
Environment=PIOS_DATA=/var/lib/pios PIOS_WEB=/opt/pios/current/web PIOS_APPS=/opt/pios/current/apps PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m uvicorn pios.main:app --host 0.0.0.0 --port 80 --no-server-header --log-level warning
Restart=always
RestartSec=3
StateDirectory=pios
StateDirectoryMode=0700
UMask=0077

# Hardening: the backend only needs to bind port 80, write /var/lib/pios and talk to local unix sockets
# (Update Manager, firewall, ClamAV). Every directive below is exercised by tests/test_service_hardening.py under real systemd.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Resource ceilings so a runaway upload or bug cannot starve the rest of the Pi
MemoryHigh=640M
MemoryMax=900M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
